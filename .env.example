# ---------------------------------------------------------------
# TutorHub environment variables
#
# Copy this file to .env.local (local) or add the same names in your
# hosting dashboard (Vercel > Project > Settings > Environment Variables).
#
# The app needs REAL services. If a REQUIRED variable is missing it shows
# a "Setup required" page that lists the missing names.
#
# NEVER commit .env.local. Variables prefixed NEXT_PUBLIC_ are sent to the
# browser; everything else stays on the server. NEXT_PUBLIC_ values are
# baked in at BUILD time, so set them before you build/deploy.
# Use Stripe TEST keys until you launch.
# ---------------------------------------------------------------

# ============================== REQUIRED ==============================

# --- App ---------------------------------------------------------
# Public base URL, no trailing slash (emails, Stripe redirects, invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security: used for webhooks, cron and public pages.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -------------------------------------------------------
# Needs Stripe CONNECT enabled on your Stripe account (tutors are Express accounts and get paid directly).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint for YOUR account (subscriptions): https://YOUR-DOMAIN/api/webhooks/stripe
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe --forward-connect-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Price ID (price_...) of the recurring monthly Pro price. Its amount and currency must match the two NEXT_PUBLIC_PRO_* values below.
STRIPE_PRO_PRICE_ID=

# --- Resend (email) -----------------------------------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend
EMAIL_FROM="TutorHub <hello@yourdomain.com>"

# --- Cron ---------------------------------------------------------
# Protects /api/cron/reminders. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one: openssl rand -hex 32
CRON_SECRET=

# ============================== OPTIONAL ==============================

# Signing secret of the SECOND webhook endpoint, the one created with "Listen to events on Connected accounts".
# Same URL as above, different secret. Needed so lesson payments, refunds and tutor onboarding events from
# tutors' Stripe accounts are accepted. (With `stripe listen` locally there is only one secret: leave this empty.)
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Pro plan price shown in the app (keep in sync with the Stripe price) ---
NEXT_PUBLIC_PRO_PRICE_CENTS=1900
NEXT_PUBLIC_PRO_CURRENCY=gbp

# --- Video: which Jitsi the lesson room uses (server-side, see src/lib/video-provider.ts) ---
# VIDEO_PROVIDER=self-hosted  your own open-source Jitsi Meet (deploy/ sets one up for you)
# VIDEO_PROVIDER=jaas         8x8 Jitsi as a Service (hosted, free up to 25 monthly users)
# VIDEO_PROVIDER=public       meet.jit.si: demo only, embedded calls are cut after 5 minutes
VIDEO_PROVIDER=public
# self-hosted:
# JITSI_DOMAIN=video.example.com
# JITSI_JWT_APP_ID=tutorhub          (optional token login so only the app can open rooms; same values as your Jitsi server)
# JITSI_JWT_APP_SECRET=
# JITSI_JWT_SUB=meet.jitsi
# jaas (jaas.8x8.vc > API keys; deploy/scripts/jaas-key.sh turns the downloaded key into one line):
# JAAS_APP_ID=vpaas-magic-cookie-...
# JAAS_KEY_ID=
# JAAS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'

# --- Only for `npm run seed` on a development/staging project ------------
# SEED_CONFIRM=yes

# ============================== OPTIONAL ==============================

# --- One-click demo login (OFF by default) ------------------------
# Shows "Demo as a tutor / student" buttons on /login. Use throwaway demo accounts, never real people's.
# `npm run seed` creates ana@/sam@demo.tutorhub.app with a KNOWN password, so run it only against a separate test Supabase project.
# Credentials stay on the server. In production it also needs DEMO_LOGIN_ALLOW_PRODUCTION=true.
# DEMO_LOGIN_ENABLED=true
# DEMO_LOGIN_ALLOW_PRODUCTION=false
# DEMO_TUTOR_EMAIL=
# DEMO_TUTOR_PASSWORD=
# DEMO_STUDENT_EMAIL=
# DEMO_STUDENT_PASSWORD=
