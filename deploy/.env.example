# TutorHub on a VPS: the one file you configure.
#
#   cp .env.example .env     (or just run ./scripts/setup.sh and it writes this for you, with secrets generated)
#   ./scripts/deploy.sh      (builds, starts and migrates; run it again after every change to this file)
#
# NEVER commit .env: it holds every secret.

# ============================================================== 1. Your domains
# Create an A record for each name below pointing at this server's public IP.
APP_DOMAIN=app.example.com
# Needed only when DATABASE_MODE=self-hosted
API_DOMAIN=api.example.com
# Needed only when VIDEO_PROVIDER=self-hosted
VIDEO_DOMAIN=video.example.com
# Let's Encrypt sends certificate warnings here
ACME_EMAIL=you@example.com
TZ=UTC

# ============================================================== 2. The two switches
# DATABASE_MODE: where your data lives
#   self-hosted  your own Supabase in this compose file (Postgres, Auth, Storage, Realtime). Everything on this server.
#   cloud        supabase.com. Fill SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY from its dashboard, and
#                run the SQL files in supabase/migrations once yourself.
DATABASE_MODE=self-hosted

# VIDEO_PROVIDER: who runs the video calls
#   self-hosted  your own open-source Jitsi Meet in this compose file (free software, you pay for the server). Section 5.
#   jaas         8x8 Jitsi as a Service (hosted, free up to 25 monthly users, no server for you to run). Section 6.
#   public       meet.jit.si. Demo only: Jitsi cuts embedded calls after 5 minutes.
VIDEO_PROVIDER=self-hosted

# ============================================================== 3. Supabase
# DATABASE_MODE=self-hosted: setup.sh generates all of these. SUPABASE_URL is https://API_DOMAIN.
# DATABASE_MODE=cloud: paste the values from supabase.com (Project settings > API) and ignore POSTGRES_PASSWORD, JWT_SECRET and REALTIME_*.
SUPABASE_URL=https://api.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=
JWT_SECRET=
REALTIME_DB_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# Email from Supabase Auth (sign-up confirmation, password reset). Resend works over SMTP:
#   host smtp.resend.com, port 465, user "resend", password = your Resend API key (the default below).
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# SMTP_PASS=            (leave unset to reuse RESEND_API_KEY)

# Optional "Continue with Google" (create the OAuth client in Google Cloud; redirect URI: SUPABASE_URL/auth/v1/callback)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================== 4. The app
CRON_SECRET=
RESEND_API_KEY=
# The app's own emails (booking confirmations, reminders). A domain verified in Resend.
EMAIL_FROM="TutorHub <no-reply@example.com>"
# Stripe needs TWO webhook endpoints with the same URL https://APP_DOMAIN/api/webhooks/stripe (each has its own signing secret):
#   1. your account:        checkout.session.completed, customer.subscription.updated, customer.subscription.deleted  -> STRIPE_WEBHOOK_SECRET
#   2. connected accounts (tick "Listen to events on Connected accounts"): checkout.session.completed,
#      checkout.session.expired, charge.refunded, account.updated                                               -> STRIPE_CONNECT_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# One-click demo accounts on /login. Use only on a test server (see ../.env.example).
DEMO_LOGIN_ENABLED=
DEMO_LOGIN_ALLOW_PRODUCTION=
DEMO_TUTOR_EMAIL=
DEMO_TUTOR_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# ============================================================== 5. VIDEO_PROVIDER=self-hosted (open-source Jitsi)
# Open these on the server firewall: 80/tcp, 443/tcp and 10000/udp (the video itself).
JVB_PUBLIC_IP=
JICOFO_AUTH_PASSWORD=
JICOFO_COMPONENT_SECRET=
JVB_AUTH_PASSWORD=
# true = only people holding a token signed by the app can open rooms on your server (recommended). false = anyone who knows a room name.
JITSI_REQUIRE_TOKEN=true
JITSI_JWT_APP_ID=tutorhub
JITSI_JWT_APP_SECRET=
# Derived from JITSI_REQUIRE_TOKEN by deploy.sh. Do not edit.
JITSI_ENABLE_AUTH=0
JITSI_ENABLE_GUESTS=1

# ============================================================== 6. VIDEO_PROVIDER=jaas (8x8 hosted)
# jaas.8x8.vc > API keys > Add API key. Then run ./scripts/jaas-key.sh <downloaded private key file> to get JAAS_PRIVATE_KEY.
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
